#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=10

PROG=/usr/bin/vianes
CONFIG=/etc/vianes/config.yaml

start_service() {
	local enabled

	config_load vianes
	config_get_bool enabled config enabled 0
	[ "$enabled" = "1" ] || return 0

	[ -f "$CONFIG" ] || {
		logger -t vianes "config file not found: $CONFIG"
		return 1
	}

	procd_open_instance
	procd_set_param command "$PROG" -c "$CONFIG"
	procd_set_param file "$CONFIG"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger vianes
}
